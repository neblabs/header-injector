{
    "name": "neblabs/header-injector",
    "description": "Injects dynamic header values for WordPress plugin file and readme headers",
    "type": "library",
    "require": {
        "php": "~8.4.1",
        "symfony/console": "^8.1",
        "adbario/php-dot-notation": "^3.5",
        "neblabs/header-parser": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Neblabs\\HeaderInjector\\": "src/"
        },
        "files": ["src/dynamicData.php"]
    },
    "scripts": {
        "test": " XDEBUG_MODE=debug XDEBUG_SESSION=1 ./vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "rafark",
            "email": "rafarks@gmail.com"
        }
    ]
}
