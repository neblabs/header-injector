{
    "chmod": "0755",
    "main": "bin/header-injector",
    "output": "build/header-injector.phar",
    "directories": ["src"],
    "finder": [
        {
            "name": "*.php",
            "exclude": ["Tests", "tests"],
            "in": "vendor"
        }
    ],
    "dump-autoload": true,
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php"
    ]
}
